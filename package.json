{
	"name": "electron-call-manager",
	"version": "1.0.0",
	"description": "GSM Call Bridge desktop app – bridges a USB GSM modem to a WebSocket audio server",
	"main": "dist/main/main.js",
	"scripts": {
		"dev": "electron .",
		"build": "webpack --config webpack.main.config.js && webpack --config webpack.renderer.config.js && webpack --config webpack.preload.config.js",
		"start": "npm run build && electron .",
		"pack": "npm run build && electron-builder --win --dir",
		"dist": "npm run build && electron-builder --win"
	},
	"build": {
		"appId": "com.voxsar.electron-call-manager",
		"productName": "Electron Call Manager",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"package.json"
		],
		"win": {
			"target": "nsis",
			"icon": null
		},
		"nsis": {
			"oneClick": false,
			"perMachine": true,
			"allowToChangeInstallationDirectory": true
		}
	},
	"dependencies": {
		"@elevenlabs/client": "^0.14.0",
		"@serialport/parser-readline": "^12.0.0",
		"electron-store": "^8.2.0",
		"serialport": "^12.0.0",
		"ws": "^8.17.0"
	},
	"devDependencies": {
		"@types/node": "^20.12.0",
		"@types/ws": "^8.5.10",
		"css-loader": "^6.11.0",
		"electron": "^29.3.0",
		"electron-builder": "^24.13.3",
		"html-webpack-plugin": "^5.6.0",
		"style-loader": "^3.3.4",
		"ts-loader": "^9.5.1",
		"typescript": "^5.4.5",
		"webpack": "^5.91.0",
		"webpack-cli": "^5.1.4"
	}
}