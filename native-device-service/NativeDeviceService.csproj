<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NativeDeviceService</AssemblyName>
    <RootNamespace>NativeDeviceService</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Single-file self-contained publish for Windows -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>1.0.0</Version>
    <Description>Native Device Service for Electron Call Manager – handles Bluetooth/audio device interactions</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 32feet.NET – cross-platform Bluetooth (Windows, Linux, macOS) -->
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.0" />
  </ItemGroup>

</Project>
